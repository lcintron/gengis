{
  "name": "gengis",
  "version": "0.17.2",
  "description": "Standalone map building tool: draw shapes, place SVGs, layers, measurement, search. PWA + Electron.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Luis Cintron",
  "main": "electron/main.js",
  "scripts": {
    "serve": "node serve.js 8080",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test": "node --expose-gc --test --test-timeout=300000 \"tests/*.test.js\"",
    "android:web": "node scripts/build-web.js",
    "android:sync": "node scripts/build-web.js && npx cap sync android && node scripts/android-prepare.js",
    "release": "node scripts/release.js",
    "version:show": "node scripts/release.js --show"
  },
  "build": {
    "appId": "local.gengis",
    "productName": "GenGIS",
    "files": ["LICENSE", "index.html", "sw.js", "manifest.webmanifest", "css/**", "js/**", "vendor/**", "data/**", "icons/**", "branding/splash/**", "electron/**"],
    "directories": { "output": "dist" },
    "artifactName": "GenGIS-${version}-${os}-${arch}.${ext}",
    "icon": "icons/icon-512.png",
    "protocols": [{ "name": "GenGIS link", "schemes": ["gengis"] }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icons/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "include": "installer/protocol.nsh" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage", "deb"], "category": "Science", "maintainer": "Luis Cintron" }
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0"
  }
}
