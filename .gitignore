# dependencies and build output
# (no lock file is committed: the workflows install without one, and the one electron-builder's install step writes
#  here must not make the working tree dirty for scripts/release.js)
node_modules/
package-lock.json
dist/
out/

# the Android app: www/ is built from the web files, android/ generated by Capacitor in CI (npm run android:sync)
www/
android/

# logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# local editor / tool state
.vscode/
.idea/
.claude/settings.local.json

# test scratch
tests/.tmp-*/

# Google desktop client secret (the release build writes it from a GitHub secret)
electron/cloud-secrets.json
