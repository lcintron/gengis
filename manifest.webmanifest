{
  "name": "GenGIS (G²)",
  "short_name": "GenGIS",
  "description": "GenGIS (G²) is a free, offline-capable GIS map builder: draw and style features, organize them in layers, measure in metric, imperial or nautical units, place SVG symbols, and overlay live airspace, boundary and point-of-interest data from open sources.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1118",
  "theme_color": "#0b1118",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
